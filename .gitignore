# 0. Ignore environment secrets (but allow the example template)
.env
.env.*
!.env.example

# 1. Ignore standard environment/package folders
node_modules/

# 2. Ignore local database files
db.json

# 3. Ignore all files inside Backend but keep the folder structure
src/Backend/*
!src/Backend/.gitkeep
!src/Backend/HomeBackend.js
!src/Backend/CheckBackend.js
!src/Backend/SpellChecker.js

# 4. Ignore all files inside Frontend subfolders but keep the folder structure
src/Frontend/Scripts/*
!src/Frontend/Scripts/.gitkeep
!src/Frontend/Scripts/CheckAssign.js
!src/Frontend/Scripts/HomeDesign.js
!src/Frontend/Scripts/Homesignup.js
!src/Frontend/Scripts/history.js
!src/Frontend/Scripts/detailedReport.js
!src/Frontend/Scripts/profile.js
!src/Frontend/Scripts/config.js
!src/Frontend/Scripts/toast.js

src/Frontend/Templates/*
!src/Frontend/Templates/.gitkeep
!src/Frontend/Templates/index.html
!src/Frontend/Templates/CheckAssign.html
!src/Frontend/Templates/DetailedReport.html
!src/Frontend/Templates/profile.html
!src/Frontend/Templates/history.html

src/Frontend/styles/*
!src/Frontend/styles/.gitkeep
!src/Frontend/styles/profile.css
!src/Frontend/styles/history.css
!src/Frontend/styles/index.css
!src/Frontend/styles/checkAssign.css
!src/Frontend/styles/detailedReport.css
